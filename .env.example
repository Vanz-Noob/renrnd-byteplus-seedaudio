# ============================================
# BytePlus Voice Chat - Environment Configuration
# ============================================
# Copy file ini menjadi .env dan isi dengan API key Anda

# --- Speech-to-Text (STT) API ---
# Dapatkan dari: https://console.byteplus.com/voice/service/8
STT_API_KEY=your_stt_api_key_here

# Bahasa untuk recognition (DEFAULT: id-ID untuk Bahasa Indonesia)
# STT 2.0 mendukung 51 bahasa termasuk: id-ID, en-US, zh-CN, ja-JP, dll
STT_LANGUAGE=id-ID

# --- Text-to-Speech (TTS) API ---
# Dapatkan dari: https://console.byteplus.com/voice/service/8
TTS_API_KEY=your_tts_api_key_here

# Voice/speaker ID (lihat daftar di: https://docs.byteplus.com/en/docs/byteplusvoice/voicelist)
# Beberapa voice populer:
#   zh_female_vv_uranus_bigtts  - Female Chinese
#   en_female_vv_uranus_bigtts - Female English
TTS_SPEAKER=zh_female_vv_uranus_bigtts

# Format audio output: mp3, ogg_opus, pcm
TTS_AUDIO_FORMAT=pcm

# Sample rate: 8000, 16000, 24000, 48000
TTS_SAMPLE_RATE=24000

# Enforce bahasa output TTS (DEFAULT: id untuk Bahasa Indonesia)
TTS_EXPLICIT_LANGUAGE=id

# --- ModelArk AI Chat API ---
# Dapatkan dari: https://ai.byteplus.com/ark/region:ap-southeast-1/apikey
ARK_API_KEY=your_ark_api_key_here

# Model ID (default: dola-seed-2-1-turbo-260628 - model paling ringan)
ARK_MODEL=dola-seed-2-1-turbo-260628

# Disable deep thinking untuk response yang lebih cepat (true/false)
# true = response cepat (direkomendasikan untuk voice chat)
ARK_DISABLE_THINKING=true

# Max output tokens (default: 1000 - cukup untuk jawaban 2-3 kalimat)
ARK_MAX_TOKENS=1000

# Custom system prompt (opsional - jika kosong, gunakan default yang enforce Bahasa Indonesia)
# SYSTEM_PROMPT=Kamu adalah asisten AI yang ramah. Selalu jawab dalam Bahasa Indonesia.

# --- Server Configuration ---
HOST=0.0.0.0
PORT=8000
